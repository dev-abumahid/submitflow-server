# Default Node config
NODE_ENV=development
PORT=5000
# Number of reverse proxies in front of the app (1 behind Caddy/Nginx). Keep 0 if exposed directly.
TRUST_PROXY=0

# Database config
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/server_db?sslmode=disable"
# Used by docker-compose for the postgres container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=server_db

# JWT Configuration
# Each secret must be a different random value of 32+ characters: `openssl rand -hex 32`
ACCESS_TOKEN=
# Access tokens are short-lived; refresh tokens (opaque, rotated on every use) last longer
ACCESS_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30
FRONT_END_URL=http://localhost:5173
# Comma separated list of allowed origins. Defaults to FRONT_END_URL.
CORS_ORIGINS=

# Cloudinary Configuration
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# Swagger Config (docs are disabled in production unless ENABLE_SWAGGER=true)
ENABLE_SWAGGER=
DEVELOPMENT_BASE_URL=http://localhost:5000
PRODUCTION_BASE_URL=

