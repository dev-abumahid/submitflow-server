enum STATUS {
    PENDING
    IN_PROGRESS
    REJECTED
    APPROVED
}

model Project {
    id               String  @id @default(uuid())
    name             String
    description      String
    gitRepoUrl       String
    previewUrl       String
    reviewerFeedBack String?
    status           STATUS  @default(PENDING)

    // relations
    submitterId String
    // empty until a mentor reviews the project
    reviewerId  String?

    submitter Account  @relation("SubmittedProjects", fields: [submitterId], references: [id], onDelete: Cascade)
    reviewer  Account? @relation("ReviewedProjects", fields: [reviewerId], references: [id], onDelete: SetNull)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([submitterId])
    @@index([status])
    @@index([createdAt])
}
